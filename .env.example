# --- AWS Bedrock (models stay in-AWS; London for UK/EU data residency) ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# If Claude/Titan are enabled directly in London, use the plain ids below.
# If not, use the EU cross-region inference profile (prefix "eu.") so calls
# route within the EU — better for health-data residency anyway:
#   BEDROCK_LLM_MODEL_ID=eu.anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Postgres + pgvector ---
# Local (docker-compose) default; swap host for RDS in production.
DATABASE_URL=postgresql://meetings:meetings@localhost:5432/meetings
