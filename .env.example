# --- AWS Bedrock (models stay in-AWS; London for UK/EU data residency) ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# EU cross-region inference profile (prefix "eu.") — calls route within the EU.
BEDROCK_LLM_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Postgres + pgvector ---
# Local (docker-compose) default; swap host for RDS in production.
DATABASE_URL=postgresql://meetings:meetings@localhost:5432/meetings
